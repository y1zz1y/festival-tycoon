{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "tests/regression.ts",
    "tests/performance.ts",
    "scripts/*.mjs",
    "scripts/import-terrain-entry.ts",
    "electron/main.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "electron/*.mjs"
  ],
  "ignoreExportsUsedInFile": true
}
