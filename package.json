{
  "name": "festival-simulator",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 36",
    "quality:dead-code": "knip --include files,dependencies,unlisted,unresolved",
    "quality:duplicates": "jscpd src server scripts --config .jscpd.json",
    "quality": "npm run lint && npm run quality:dead-code && npm run quality:duplicates",
    "validate": "npm run quality && npm test && npm run build && npm run test:docs",
    "test": "node scripts/test.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:performance": "node scripts/profile-simulation.mjs",
    "test:performance:fixtures": "node scripts/profile-simulation.mjs --fixtures",
    "test:install": "node tests/installableApp.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node --experimental-strip-types server/serve.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "rolldown": "^1.2.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.3"
  }
}
